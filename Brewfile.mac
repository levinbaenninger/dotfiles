# macOS-only formulae and apps. Installed after the portable Brewfile.

# System
brew "mole"

# Build toolchains & runtimes
brew "dotnet"
brew "gcc"

# Documents & media
brew "ghostscript"
brew "imagemagick"
brew "tectonic"

# Security & network
brew "gnupg"
brew "openvpn"

# Editors & IDEs
