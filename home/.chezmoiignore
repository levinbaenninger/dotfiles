{{- if not .work }}
# Work-only files: never rendered on personal machines, so 1Password's Work
# vault is only touched where it exists.
.config/dotfiles/work.env
.config/git/work.gitconfig
.npmrc
{{- end }}

{{- if eq .profile "mac" }}
# systemd user-service environment; macOS has no systemd.
.config/environment.d
.config/environment.d/**
{{- end }}

{{- if ne .profile "mac" }}
# The SSH config wires in the 1Password agent socket and OrbStack, both macOS.
.ssh
.ssh/**
{{- end }}

{{- if ne .containerRuntime "podman" }}
.local/bin/docker
{{- end }}

{{- if not (and .work .headless) }}
# Azure DevOps git credential helper: headless work VMs only.
.local/bin/git-credential-azure-devops
{{- end }}
