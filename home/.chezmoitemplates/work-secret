{{- /* Usage: includeTemplate "work-secret" (list . "field")          required
              includeTemplate "work-secret" (list . "field" "default") optional
       Reads a field of the 1Password item Work/dotfiles. Machines with the
       1Password app read it directly (one `op` call, cached); headless work VMs
       read the copy scripts/push-work-secrets.sh put in
       ~/.config/dotfiles/work-secrets.json. */ -}}
{{- $root := index . 0 -}}
{{- $field := index . 1 -}}
{{- $optional := gt (len .) 2 -}}
{{- $value := "" -}}
{{- if eq $root.workSecrets "file" -}}
{{-   $file := joinPath $root.chezmoi.homeDir ".config/dotfiles/work-secrets.json" -}}
{{-   if not (stat $file) -}}
{{-     fail (printf "%s is missing; run scripts/push-work-secrets.sh <host> on the Mac" $file) -}}
{{-   end -}}
{{-   $value = index (include $file | fromJson) $field | default "" -}}
{{- else -}}
{{-   range (onepassword "dotfiles" "Work").fields -}}
{{-     if and (eq (.label | default "") $field) (not $value) -}}
{{-       $value = .value | default "" -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if and (not $value) $optional -}}
{{-   $value = index . 2 -}}
{{- end -}}
{{- if and (not $value) (not $optional) -}}
{{-   fail (printf "field %q is missing in 1Password item Work/dotfiles" $field) -}}
{{- end -}}
{{- $value -}}
