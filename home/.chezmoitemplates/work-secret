{{- /* Usage: includeTemplate "work-secret" (list . "field")
       Reads a field of the 1Password item Work/dotfiles. Machines with the
       1Password app read it directly; headless work VMs read the copy that
       scripts/push-work-secrets.sh puts in ~/.config/dotfiles/work-secrets.json. */ -}}
{{- $root := index . 0 -}}
{{- $field := index . 1 -}}
{{- if eq $root.workSecrets "file" -}}
{{-   $file := joinPath $root.chezmoi.homeDir ".config/dotfiles/work-secrets.json" -}}
{{-   if not (stat $file) -}}
{{-     fail (printf "%s is missing; run scripts/push-work-secrets.sh <host> on the Mac" $file) -}}
{{-   end -}}
{{-   $value := index (include $file | fromJson) $field -}}
{{-   if not $value -}}
{{-     fail (printf "field %q missing in %s" $field $file) -}}
{{-   end -}}
{{-   $value -}}
{{- else -}}
{{-   onepasswordRead (printf "op://Work/dotfiles/%s" $field) -}}
{{- end -}}
