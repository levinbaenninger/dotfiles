#!/usr/bin/env bash
# Syncs the shared agent setup from .chezmoidata/agents.yaml:
#   skills  -> ~/.agents/skills (Codex reads it directly), linked into ~/.claude/skills
#   retired -> skills, plugins and marketplaces removed from both agents
#   MCP     -> Claude Code user scope (Codex gets them via ~/.codex/config.toml)
#   hooks   -> herdr's Claude/Codex integrations
# Re-runs whenever that data (or the work flag) changes.
# data hash: {{ list .agents.skills .agents.retired .agents.claude .agents.codex .agents.mcp .work | toJson | sha256sum }}
# MCP JSON keeps $HOME/$ADO_ORG literal on purpose; sh expands them when the
# server starts.
# shellcheck disable=SC2016
set -euo pipefail
export PATH="$HOME/.local/bin:{{ .brewPrefix }}/bin:/usr/local/bin:$PATH"
# shellcheck disable=SC1091
[[ -f "$HOME/.vite-plus/env" ]] && . "$HOME/.vite-plus/env"
# Keep Vite+'s npm tools ahead of Windows' PATH in this non-interactive shell.
export PATH="$HOME/.vite-plus/bin:$HOME/.vite-plus/fallback-bin:$PATH"
export DO_NOT_TRACK=1 DISABLE_TELEMETRY=1

# --- Skills ------------------------------------------------------------------
echo "==> Agent skills"
mkdir -p "$HOME/.claude/skills"
# Retired skills: only those the skills CLI still tracks, so a p3-stack link of
# the same name survives. Their Claude links are left dangling, so drop those.
for skill in {{ range .agents.retired.skills }}{{ . | squote }} {{ end }}; do
  if jq -e --arg s "$skill" '.skills[$s]' "$HOME/.agents/.skill-lock.json" >/dev/null 2>&1; then
    npx -y skills@latest remove "$skill" --global --yes
  fi
  link="$HOME/.claude/skills/$skill"
  if [[ -L "$link" && ! -e "$link" ]]; then rm "$link"; fi
done
{{- range .agents.skills }}
npx -y skills@latest add {{ .source | squote }} --global --agent codex --yes
{{- range .skills }} --skill {{ . | squote }}{{ end }}
{{- if .claude }}
# shellcheck disable=SC2041
for skill in {{ range .skills }}{{ . | squote }} {{ end }}; do
  ln -sfn "../../.agents/skills/$skill" "$HOME/.claude/skills/$skill"
done
{{- end }}
{{- end }}

if command -v codex >/dev/null; then
  echo "==> Codex plugins"
{{- range .agents.retired.codex.plugins }}
  codex plugin remove {{ . | squote }} >/dev/null 2>&1 || true
{{- end }}
{{- range .agents.retired.codex.marketplaces }}
  codex plugin marketplace remove {{ . | squote }} >/dev/null 2>&1 || true
{{- end }}
{{- range $name, $_ := get .agents.codex.config.managed "marketplaces" | default dict }}
  codex plugin marketplace upgrade {{ $name | squote }}
{{- end }}
{{- range .agents.codex.plugins }}
  codex plugin add {{ . | squote }}
{{- end }}
else
  echo "codex not on PATH; skipping plugins" >&2
fi

# --- Claude Code: plugins & MCP servers ---------------------------------------
if command -v claude >/dev/null; then
  echo "==> Claude Code plugins"
  # A fresh install doesn't know any marketplace until Claude first starts.
{{- range .agents.claude.marketplaces }}
  claude plugin marketplace add {{ . | squote }} >/dev/null 2>&1 || true
{{- end }}
  claude plugin marketplace update
{{- range .agents.claude.plugins }}
  claude plugin install --scope user {{ . | squote }}
  claude plugin update --scope user {{ . | squote }}
{{- end }}
  # Retire after installing, so a replacement is in place first.
{{- range .agents.retired.claude.plugins }}
  claude plugin uninstall --scope user {{ . | squote }} >/dev/null 2>&1 || true
{{- end }}
{{- range .agents.retired.claude.marketplaces }}
  claude plugin marketplace remove {{ . | squote }} >/dev/null 2>&1 || true
{{- end }}

  echo "==> Claude Code MCP servers"
  # Only touch servers whose definition changed: re-adding one resets its
  # OAuth login.
  add_mcp() {
    local current
    current=$(jq -cS --arg n "$1" '.mcpServers[$n] // empty' "$HOME/.claude.json" 2>/dev/null || true)
    [[ "$current" == "$(jq -cS . <<<"$2")" ]] && return 0
    claude mcp remove --scope user "$1" >/dev/null 2>&1 || true
    claude mcp add-json --scope user "$1" "$2"
  }
{{- $servers := deepCopy .agents.mcp.common }}
{{- if .work }}
{{-   $servers = merge $servers (deepCopy .agents.mcp.work) }}
{{- end }}
{{- range $name, $srv := $servers }}
{{-   $json := dict }}
{{-   if hasKey $srv "url" }}
{{-     $json = dict "type" "http" "url" $srv.url }}
{{-   else }}
{{-     $json = dict "type" "stdio" "command" $srv.command "args" ($srv.args | default list) }}
{{-   end }}
  add_mcp {{ $name | squote }} '{{ toJson $json | replace "'" "'\\''" }}'
{{- end }}
else
  echo "claude not on PATH; skipping plugins and MCP servers" >&2
fi

# --- herdr hooks ---------------------------------------------------------------
if command -v herdr >/dev/null; then
  echo "==> herdr integrations"
  herdr integration install claude || true
  herdr integration install codex || true
fi
