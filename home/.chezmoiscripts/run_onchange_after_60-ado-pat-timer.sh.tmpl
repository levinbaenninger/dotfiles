{{ if and .work (eq .profile "wsl") -}}
#!/usr/bin/env bash
# Enable the weekly Azure DevOps PAT renewal (WSL work laptop).
# units: {{ include "dot_config/systemd/user/ado-pat-renew.service.tmpl" | sha256sum }} {{ include "dot_config/systemd/user/ado-pat-renew.timer" | sha256sum }}
set -euo pipefail
if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "WSL has no systemd: add '[boot]' + 'systemd=true' to /etc/wsl.conf, run 'wsl --shutdown' in Windows, then 'chezmoi apply' again." >&2
  exit 0
fi
systemctl --user daemon-reload
systemctl --user enable --now ado-pat-renew.timer
echo "Azure DevOps PAT renewal timer enabled (weekly)."
{{ end -}}
