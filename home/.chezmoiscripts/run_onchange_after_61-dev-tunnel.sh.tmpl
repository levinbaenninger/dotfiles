{{ if and .work (eq .profile "wsl") -}}
#!/usr/bin/env bash
# Keep the dev-server port tunnel to the work VM running (WSL work laptop).
# unit: {{ include "dot_config/systemd/user/dev-tunnel.service.tmpl" | sha256sum }} ports: {{ join " " .fleet.ports }} vm: {{ index .fleet.work 0 }}
set -euo pipefail
if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "WSL has no systemd: add '[boot]' + 'systemd=true' to /etc/wsl.conf, run 'wsl --shutdown' in Windows, then 'chezmoi apply' again." >&2
  exit 0
fi
systemctl --user daemon-reload
systemctl --user enable dev-tunnel.service
systemctl --user restart dev-tunnel.service
echo "Dev-server port tunnel enabled (systemctl --user status dev-tunnel)."
{{ end -}}
