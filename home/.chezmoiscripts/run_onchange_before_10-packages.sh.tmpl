#!/usr/bin/env bash
# Re-runs whenever a Brewfile changes.
# Brewfile hash: {{ include (joinPath .chezmoi.workingTree "Brewfile") | sha256sum }}
{{- if eq .profile "mac" }}
# Brewfile.mac hash: {{ include (joinPath .chezmoi.workingTree "Brewfile.mac") | sha256sum }}
{{- end }}
{{- if .work }}
# Brewfile.work hash: {{ include (joinPath .chezmoi.workingTree "Brewfile.work") | sha256sum }}
{{- end }}
set -euo pipefail

brew="{{ .brewPrefix }}/bin/brew"
if [[ ! -x "$brew" ]]; then
  echo "Homebrew missing at $brew; run ~/dotfiles/install.sh first." >&2
  exit 1
fi
export HOMEBREW_NO_ENV_HINTS=1

# shellcheck disable=SC2043 # one file on Linux, two on macOS
for file in Brewfile{{ if eq .profile "mac" }} Brewfile.mac{{ end }}{{ if .work }} Brewfile.work{{ end }}; do
  path="{{ .chezmoi.workingTree }}/$file"
  "$brew" bundle check --no-upgrade --file="$path" >/dev/null 2>&1 && continue
  echo "==> brew bundle $file"
  # One failing cask (e.g. an app installed outside Homebrew) shouldn't stop
  # the rest of the setup; brew prints what failed.
  "$brew" bundle install --no-upgrade --file="$path" || echo "brew bundle $file reported failures (see above)" >&2
done
