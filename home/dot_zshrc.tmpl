# Managed by chezmoi: edit ~/dotfiles/home/dot_zshrc.tmpl, then `chezmoi apply`.
# Machine-local additions go in ~/.zshrc.local (not tracked).

# ----------
# PATH setup
# ----------
if [[ -x {{ .brewPrefix }}/bin/brew ]]; then
  eval "$({{ .brewPrefix }}/bin/brew shellenv zsh)"
fi
export PATH="$HOME/.local/bin:$PATH"
typeset -U path  # drop duplicates (.zshenv sets PATH too on Linux)

# Agents (Claude Code, Codex) run commands through this shell. Keep their
# environment predictable: no alias swaps, no autocorrect prompts.
[[ -n "$CLAUDECODE" || -n "$CODEX_THREAD_ID" || -n "$CODEX_SANDBOX" ]] && _agent_shell=1

# -----------------
# zsh options
# -----------------
setopt AUTO_CD
setopt EXTENDED_GLOB
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
[[ -z "$_agent_shell" ]] && setopt CORRECT

# -----------------
# History config
# -----------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

# -----------------
# Completion system
# -----------------
autoload -Uz compinit
compinit

# Improve completion UX
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# -----------------
# Prompt & shell tools
# -----------------
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v atuin >/dev/null && eval "$(atuin init zsh)"
command -v fzf >/dev/null && source <(fzf --zsh)

export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border --prompt='❯ '"
export EDITOR=nvim
export VISUAL=nvim

# -----------------
# Aliases – Modern replacements (interactive shells only)
# -----------------
if [[ -z "$_agent_shell" ]]; then
  # File listing & navigation
  alias ls="eza --group-directories-first"
  alias ll="eza -lah --group-directories-first"
  alias la="eza -a"
  alias tree="eza --tree"

  # File viewing & search
  alias cat="bat"
  alias find="fd"
  alias grep="rg"

  # Disk & process tools
  alias du="dust"
  alias df="duf"
  alias ps="procs"

  # Navigation
  alias cd="z"
  alias cdi="zi"

  # Help & docs
  alias help="tldr"
  alias man="batman"
fi

# -----------------
# Git aliases
# -----------------
alias g="git"
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gcm="git commit -m"
alias gp="git push"
alias gl="git pull"
alias gd="git diff"
alias gds="git diff --staged"

alias lg="lazygit"

{{ if eq .profile "mac" -}}
# -----------------
# IDE shortcuts
# -----------------
alias code="code ."
alias webstorm="webstorm ."
alias rider="rider ."

{{ end -}}
# -----------------
# Misc quality-of-life
# -----------------
alias reload="source ~/.zshrc"
alias cls="clear"
alias dot="chezmoi"

# -----------------
# zsh-autosuggestions and zsh-syntax-highlighting
# -----------------
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" 2>/dev/null
  source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" 2>/dev/null
fi

{{ if .work -}}
# Work secrets rendered from 1Password (see ~/.config/dotfiles/work.env)
[ -f "$HOME/.config/dotfiles/work.env" ] && source "$HOME/.config/dotfiles/work.env"
{{- if eq .profile "wsl" }}

# Surface Azure DevOps PAT renewal problems (scripts/renew-ado-pat.sh).
if [[ -z "$_agent_shell" && -r "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/ado-pat.status" ]]; then
  read -r _ado_ts _ado_level _ado_msg < "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/ado-pat.status"
  [[ "$_ado_level" != ok ]] && print -P "%F{yellow}⚠ $_ado_msg%f"
  unset _ado_ts _ado_level _ado_msg
fi
{{- end }}

{{ end -}}
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# Vite+ bin (https://viteplus.dev) — sourced last so its bin wins position 1 in PATH
[ -f "$HOME/.vite-plus/env" ] && . "$HOME/.vite-plus/env"

unset _agent_shell
