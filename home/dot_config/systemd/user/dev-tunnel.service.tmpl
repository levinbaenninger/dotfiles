# Managed by chezmoi (WSL work laptop only). The work network only lets 443
# and SSH out. This forwards every port listening on the server's localhost
# to localhost here, shifted by 10000 (5173 -> 15173). Windows apps reach
# them through WSL's localhost forwarding.
[Unit]
Description=Forward dev-server ports from {{ .fleet.tunnelHost }} to localhost

[Service]
# WSL's ssh uses its own key to authenticate to the Hetzner server.
ExecStart=/bin/bash %h/.local/bin/dev-tunnel {{ .fleet.tunnelHost }}
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
