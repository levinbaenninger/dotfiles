# Managed by chezmoi (Linux only). PATH for systemd user services, which don't
# read shell rc files: the T3 Code server needs cloudflared (Homebrew) for
# T3 Connect, and launches claude (~/.local/bin), codex and node (Vite+).
# Named 99-path so it sorts after Ubuntu's 99-environment.conf, which resets
# PATH from /etc/environment.
PATH={{ .chezmoi.homeDir }}/.vite-plus/bin:{{ .chezmoi.homeDir }}/.local/bin:{{ .brewPrefix }}/bin:{{ .brewPrefix }}/sbin:${PATH}
{{- if eq .profile "exe" }}
# gh (e.g. PRs opened by agents in T3) uses the exe.dev GitHub integration.
GH_HOST=github.int.exe.xyz
{{- end }}
