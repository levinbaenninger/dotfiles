# Rendered only on work machines (mode 0600). Values come from 1Password
# (op://Work/dotfiles). Sourced by ~/.zshrc and by the work MCP server commands
# in ~/dotfiles/home/.chezmoidata/agents.yaml. Re-render with `chezmoi apply`.
export ADO_ORG={{ onepasswordRead "op://Work/dotfiles/ado_org" | squote }}
export SONARQUBE_URL={{ onepasswordRead "op://Work/dotfiles/sonarqube_url" | squote }}
export SONARQUBE_TOKEN={{ onepasswordRead "op://Work/dotfiles/sonarqube_token" | squote }}
