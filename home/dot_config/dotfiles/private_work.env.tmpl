# Rendered only on work machines (mode 0600). Values come from 1Password
# (op://Work/dotfiles). Sourced by ~/.zshrc and by the work MCP server commands
# in ~/dotfiles/home/.chezmoidata/agents.yaml. Re-render with `chezmoi apply`.
export ADO_ORG={{ includeTemplate "work-secret" (list . "ado_org") | squote }}
export SONARQUBE_URL={{ includeTemplate "work-secret" (list . "sonarqube_url") | squote }}
export SONARQUBE_TOKEN={{ includeTemplate "work-secret" (list . "sonarqube_token") | squote }}
{{- $adoPat := includeTemplate "work-secret" (list . "ado_pat" "") }}
{{- if $adoPat }}
# Azure DevOps PAT: git (headless machines) and the Azure DevOps MCP server.
export ADO_PAT={{ $adoPat | squote }}
{{- end }}
# Container CLI for MCP servers that run in containers (SonarQube).
export CONTAINER_RUNTIME={{ .containerRuntime | squote }}
