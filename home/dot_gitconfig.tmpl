{{- $serverSigningKey := joinPath .chezmoi.homeDir ".ssh/id_ed25519_signing_r2d2" -}}
{{- $serverSigns := and (eq .profile "linux") (lstat $serverSigningKey) -}}
[user]
	name = Levin Bänninger
	email = levin@baenninger.me
	signingkey = {{ if $serverSigns }}{{ $serverSigningKey }}{{ else }}ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMuaNccuT9k3GO2o9biMGqvHcyz6GGKvtvtIODgc1Dlg{{ end }}
[core]
	pager = delta
{{- if eq .profile "wsl" }}
	# Use Windows' OpenSSH so the 1Password agent on the Windows side answers.
	sshCommand = ssh.exe
{{- end }}
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
[rerere]
	enabled = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autoStash = true
	updateRefs = true

# Credentials and other settings specific to this machine.
[include]
	path = ~/.gitconfig.local

{{- /* Desktop machines use 1Password. R2-D2 signs with its local, signing-only
       key when it exists; other headless machines leave signing disabled. */}}
{{- $signer := "" }}
{{- if eq .profile "mac" }}
{{-   $signer = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" }}
{{- else if eq .profile "wsl" }}
{{-   $signer = lookPath "op-ssh-sign-wsl.exe" | default (lookPath "op-ssh-sign-wsl") }}
{{- else if $serverSigns }}
{{-   $signer = "ssh-keygen" }}
{{- end }}
{{- if $signer }}
[gpg]
	format = ssh
[gpg "ssh"]
	program = {{ $signer | quote }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}

{{- $gh := joinPath .brewPrefix "bin/gh" }}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential

{{- if and .work .headless }}

# Azure DevOps over HTTPS: PAT from 1Password (ado_pat), else `az login`.
[credential "https://dev.azure.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/bin/git-credential-azure-devops
[credential "https://*.visualstudio.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/bin/git-credential-azure-devops
{{- end }}

{{- if .work }}

# Work identity (name/email from 1Password) for Azure DevOps remotes and for
# anything under ~/work/ or ~/source/work/. Everything else commits as the
# personal identity.
[includeIf "gitdir:~/work/"]
	path = ~/.config/git/work.gitconfig
[includeIf "gitdir:~/source/work/"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://dev.azure.com/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://*@dev.azure.com/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:git@ssh.dev.azure.com:*/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@ssh.dev.azure.com/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://*.visualstudio.com/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://*@*.visualstudio.com/**"]
	path = ~/.config/git/work.gitconfig
{{- end }}
