{{- /* The Mac and R2-D2 sign with a local, signing-only key so unattended
       agents can commit without a 1Password Touch ID prompt. */ -}}
{{- $localSigningKey := joinPath .chezmoi.homeDir (ternary ".ssh/id_ed25519_signing_falcon" ".ssh/id_ed25519_signing_r2d2" (eq .profile "mac")) -}}
{{- $localSigns := and (ne .profile "wsl") (lstat $localSigningKey) -}}
[user]
	name = Levin Bänninger
	email = levin@baenninger.me
	signingkey = {{ if $localSigns }}{{ $localSigningKey }}{{ else }}ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMuaNccuT9k3GO2o9biMGqvHcyz6GGKvtvtIODgc1Dlg{{ end }}
[core]
	pager = delta
{{- if eq .profile "wsl" }}
	# Use Windows' OpenSSH so the 1Password agent on the Windows side answers.
	sshCommand = ssh.exe
{{- end }}
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
[rerere]
	enabled = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autoStash = true
	updateRefs = true

# Credentials and other settings specific to this machine.
[include]
	path = ~/.gitconfig.local

{{- /* WSL signs through 1Password. The Mac and R2-D2 use their local key when it
       exists; the Mac falls back to 1Password without one. Other headless
       machines leave signing disabled. */}}
{{- $signer := "" }}
{{- if $localSigns }}
{{-   $signer = "ssh-keygen" }}
{{- else if eq .profile "mac" }}
{{-   $signer = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" }}
{{- else if eq .profile "wsl" }}
{{-   $signer = lookPath "op-ssh-sign-wsl.exe" | default (lookPath "op-ssh-sign-wsl") }}
{{- end }}
{{- if $signer }}
[gpg]
	format = ssh
[gpg "ssh"]
	program = {{ $signer | quote }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}

{{- $gh := joinPath .brewPrefix "bin/gh" }}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{- if eq .profile "mac" }}

# Talk to GitHub over HTTPS (gh's token) instead of SSH, so fetch and push
# don't wait for a 1Password Touch ID prompt either.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
{{- end }}

{{- if and .work .headless }}

# Azure DevOps over HTTPS: PAT from 1Password (ado_pat), else `az login`.
[credential "https://dev.azure.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/bin/git-credential-azure-devops
[credential "https://*.visualstudio.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/bin/git-credential-azure-devops
{{- end }}

{{- if .work }}

# Work identity (name/email from 1Password) for Azure DevOps remotes and for
# anything under ~/work/ or ~/source/work/. Everything else commits as the
# personal identity.
[includeIf "gitdir:~/work/"]
	path = ~/.config/git/work.gitconfig
[includeIf "gitdir:~/source/work/"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://dev.azure.com/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://*@dev.azure.com/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:git@ssh.dev.azure.com:*/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@ssh.dev.azure.com/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://*.visualstudio.com/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://*@*.visualstudio.com/**"]
	path = ~/.config/git/work.gitconfig
{{- end }}
