#!/bin/sh
# Git credential helper for Azure DevOps (dev.azure.com, *.visualstudio.com)
# on headless work machines. Uses the PAT from 1Password (ado_pat, exported as
# ADO_PAT in work.env); without one it falls back to an Entra token from the
# Azure CLI (`az login`), for devices where that sign-in is allowed.
[ "$1" = "get" ] || exit 0
cat >/dev/null # git's request on stdin; the credential is the same for every repo
# shellcheck disable=SC1091
[ -f "$HOME/.config/dotfiles/work.env" ] && . "$HOME/.config/dotfiles/work.env"
if [ -n "${ADO_PAT:-}" ]; then
  printf 'username=pat\npassword=%s\n' "$ADO_PAT"
  exit 0
fi
# 499b84ac-... is Azure DevOps' fixed resource ID.
token=$(az account get-access-token \
  --resource 499b84ac-1321-427f-aa17-267ca6975798 \
  --query accessToken --output tsv 2>/dev/null) || {
  echo "git-credential-azure-devops: no ado_pat in 1Password Work/dotfiles and no az login" >&2
  exit 1
}
printf 'username=azure-cli\npassword=%s\n' "$token"
