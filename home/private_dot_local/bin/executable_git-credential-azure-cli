#!/bin/sh
# Git credential helper for Azure DevOps: hands git a fresh Microsoft Entra
# token from the Azure CLI (`az login` once), so there's no PAT to rotate.
# Wired up in ~/.gitconfig for dev.azure.com on headless work machines.
[ "$1" = "get" ] || exit 0
cat >/dev/null # git's request on stdin; the token is the same for every repo
# 499b84ac-... is Azure DevOps' fixed resource ID.
token=$(az account get-access-token \
  --resource 499b84ac-1321-427f-aa17-267ca6975798 \
  --query accessToken --output tsv 2>/dev/null) || {
  echo "git-credential-azure-cli: no Azure token; run 'az login --use-device-code'" >&2
  exit 1
}
printf 'username=azure-cli\npassword=%s\n' "$token"
